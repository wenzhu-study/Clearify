  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
